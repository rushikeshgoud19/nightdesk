# Copy this file to `.env` and fill in your own key. `.env` is gitignored.
#
#     cp .env.example .env
#
# Get a key at https://openrouter.ai/settings/keys
# Never paste a key into a chat, an issue, a commit, or a screenshot. If you do,
# delete it on that page and make a new one -- rotating takes ten seconds.

OPENROUTER_API_KEY=sk-or-v1-replace-me
