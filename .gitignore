# --- secrets. nothing here is ever committed ---
.env
.env.*
!.env.example
*.key

# --- generated toolchain files ---
# NOTE: '#' only starts a comment at the START of a line. A trailing comment
# becomes part of the pattern and silently matches nothing.

# selene generate-roblox-std output, regenerated per clone
roblox.yml
# rojo sourcemap, regenerated on demand
sourcemap.json
# wally install output
Packages/
ServerPackages/
DevPackages/

# --- build output ---
*.rbxl
*.rbxlx
*.rbxm
*.rbxmx
*.rbxl.lock
*.rbxlx.lock

# --- editor / os ---
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# --- asset build output ---
# .blend files are source and belong in git. Exported .fbx are intermediates on
# the way to a Roblox asset ID -- regenerate them with tools/blender_export.py.
assets/*.fbx
assets/*.obj
assets/*.glb
