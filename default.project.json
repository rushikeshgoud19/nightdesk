    // Every MaterialVariant in the game is declared HERE, not created at runtime.
    // MaterialVariant.BaseMaterial carries Plugin security, so a game Script that
    // writes it throws "lacking capability Plugin". That is what took the entire
    // lobby build down for a session -- buildLobby() raised on its first variant,
    // init.server.luau calls it unprotected, and nothing after line 12 ran. No
    // build, lint or format step noticed. Rojo writes the place file directly and
    // is not subject to the check. Add a material by adding it here;
    // src/shared/Materials.luau only names them.
    //
    // StudsPerTile is the size of one texture repeat in studs. Guest surfaces are
    // small -- a cheekbone is about 0.3 studs -- so their tiles are sub-stud or
    // the detail stretches into invisible blur.
    "MaterialService": {
      "$className": "MaterialService",
      // GUEST SURFACES. These seven were generated in Studio during the guest-kit
      // pass and never written here -- and Rojo OWNS MaterialService, so the next
      // sync replaced the whole service with the Motel* set and the Guest* names
      // stopped resolving. A MaterialVariant name that does not resolve renders as
      // the purple-and-black checkerboard, which was then misread as a capability
      // error and worked around by dropping to stock materials with colour tints.
      // Declared here, they survive the sync. That was the whole bug.
      // Pores and a broken specular. The surface colorless_skin and the tier-1 skin-tone tells have to read against.
      "GuestSkin": {
        "$className": "MaterialVariant",
        "$properties": {
          "BaseMaterial": "SmoothPlastic",
          "StudsPerTile": 0.5,
          "ColorMap": "rbxassetid://97295374627629",
          "NormalMap": "rbxassetid://107498800381317",
          "RoughnessMap": "rbxassetid://125175590849695",
          "MetalnessMap": "rbxassetid://96277239383984"
        }
      },
      // Strand sheen on the sculpted hair mesh.
      "GuestHair": {
        "$className": "MaterialVariant",
        "$properties": {
          "BaseMaterial": "SmoothPlastic",
          "StudsPerTile": 0.6,
