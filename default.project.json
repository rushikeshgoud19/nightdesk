{
  "name": "nightdesk",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": {
        "$path": "src/server"
      },
      "Packages": {
        "$path": "ServerPackages"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "FilteringEnabled": true
      },
      "Spawn": {
        "$className": "SpawnLocation",
        "$properties": {
          "Size": [6, 1, 6],
          "Position": [0, 3.5, 7.5],
          "Anchored": true,
          "Neutral": true,
          "Transparency": 1,
          "CanCollide": false
        }
      }
    },
    // Color3 here is FLOATS 0-1, never 0-255. Anything above 1.0 clamps to white:
    // [35, 35, 45] silently became pure white ambient, flooding the scene flat and
    // removing every shadow. Multiply by 255 to read as RGB -- 0.12 is about 31.
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Technology": "Future",
        "Ambient": [0.12, 0.12, 0.15],
        "OutdoorAmbient": [0.07, 0.07, 0.10],
        "Brightness": 0.4,
        "ClockTime": 2.0,
        "GlobalShadows": true,
        "ExposureCompensation": 0,
        "FogEnd": 120,
        "FogColor": [0.03, 0.03, 0.05]
      }
    },
    "SoundService": {
      "$className": "SoundService",
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
