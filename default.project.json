{
  "name": "nightdesk",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": {
        "$path": "src/server"
      },
      "Packages": {
        "$path": "ServerPackages"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "FilteringEnabled": true
      },
      "Spawn": {
        "$className": "SpawnLocation",
        "$properties": {
          "Size": [6, 1, 6],
          "Position": [0, 3.5, 7.5],
          "Anchored": true,
          "Neutral": true,
          "Transparency": 1,
          "CanCollide": false
        }
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Technology": "Future",
        "Ambient": [0.03, 0.03, 0.04],
        "OutdoorAmbient": [0.02, 0.02, 0.03],
        "Brightness": 0.4,
        "ClockTime": 2.0,
        "GlobalShadows": true,
        "ExposureCompensation": -0.1,
        "FogEnd": 120,
        "FogColor": [0.03, 0.03, 0.05]
      }
    },
    "SoundService": {
      "$className": "SoundService",
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
