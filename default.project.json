{
  "name": "nightdesk",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "FilteringEnabled": true
      },
      "Spawn": {
        "$className": "SpawnLocation",
        "$properties": {
          "Size": [6, 1, 6],
          "Position": [0, 0.5, -9],
          "Anchored": true,
          "Neutral": true,
          "Transparency": 1,
          "CanCollide": false
        }
      },
      "Lobby": {
        "$path": "src/world/Lobby"
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Technology": "Future",
        "Ambient": [0.03, 0.03, 0.04],
        "OutdoorAmbient": [0.05, 0.05, 0.06],
        "Brightness": 0.4,
        "ClockTime": 2,
        "GlobalShadows": true,
        "FogEnd": 220,
        "FogColor": [0.04, 0.04, 0.05]
      }
    },
    "SoundService": {
      "$className": "SoundService",
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
